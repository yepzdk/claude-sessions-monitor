# Maintainer: Jesper Pedersen <pejes@aarhus.dk>
#
# Generated by packaging/aur/render.sh from this template — edit the template,
# never the rendered PKGBUILD, which the release workflow overwrites.

_pkgname=csm
pkgname=csm-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Lightweight CLI to monitor Claude Code sessions across multiple projects"
arch=('x86_64' 'aarch64')
url="https://github.com/yepzdk/claude-sessions-monitor"
license=('MIT')
# No depends: the release binaries are built with CGO_ENABLED=0 and are
# statically linked, so they need nothing from the system at runtime.
provides=("$_pkgname")
conflicts=("$_pkgname")
# A released binary is what upstream published and what its checksum covers.
# Stripping it here would change the file the checksum vouched for.
options=('!strip' '!debug')

source=("LICENSE-$pkgver::$url/raw/v$pkgver/LICENSE")
sha256sums=('@SHA256_LICENSE@')

source_x86_64=("$_pkgname-$pkgver-x86_64::$url/releases/download/v$pkgver/csm-linux-amd64")
sha256sums_x86_64=('@SHA256_AMD64@')

source_aarch64=("$_pkgname-$pkgver-aarch64::$url/releases/download/v$pkgver/csm-linux-arm64")
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
	install -Dm755 "$srcdir/$_pkgname-$pkgver-$CARCH" "$pkgdir/usr/bin/$_pkgname"
	install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
